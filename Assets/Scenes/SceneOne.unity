  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "He visto lo que el amo alquimista te ha hecho. Convertirte en una pelota...
    C\xF3mo puede ser tan cruel! No me conoces pero trabajo aqu\xED y me s\xE9 esto
    como la palma de mi mano. Voy a ayudarte a escapar, pero no prometo que lo hagas
    de una pieza. Necesitas conseguir una llave en cada sala para abrir la puerta
    de arriba. D\xF3nde estar\xE1 la de esta habitaci\xF3n? No lo s\xE9, pero al
    amo le gustan los sitios altos, empieza mirando por aqu\xED..."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
